{
  "manifest_version": 3,
  "name": "Sobrevida",
  "version": "0.4.1",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/sw.js",
    "scripts": [
      "src/sw.js"
    ]
  },
  "permissions": [
    "storage",
    "alarms",
    "downloads",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://pokesurvivor.com/*",
    "https://ice.pokesurvivor.com/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pokesurvivor.com/*"
      ],
      "js": [
        "src/piloto.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokesurvivor.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/novidades.js",
        "src/dados.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "Dreds",
  "homepage_url": "https://github.com/DredsGG/sobrevida",
  "browser_specific_settings": {
    "gecko": {
      "id": "sobrevida@dredsgg",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/DredsGG/sobrevida/main/firefox/updates.json"
    }
  }
}
